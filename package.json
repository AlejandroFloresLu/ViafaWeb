{
  "name": "viafa-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Demo de rediseño web para Viafa Agencia de Viajes",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"const f=require('fs');f.copyFileSync('dist/app.html','index.html');f.copyFileSync('dist/app.html','viafa-demo.html');f.mkdirSync('admin',{recursive:true});f.copyFileSync('public/admin/index.html','admin/index.html')\"",
    "preview": "vite preview",
    "simulacion": "VITE_SIMULACION=1 vite build --outDir dist-sim && node -e \"require('fs').copyFileSync('dist-sim/app.html','viafa-simulacion.html')\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.3",
    "vite-plugin-singlefile": "^2.2.0"
  }
}
